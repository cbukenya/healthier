# Healthier configuration.
# Copy to .env and fill in every value marked REQUIRED. The app refuses to
# start, and lists what is missing, until they are set.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Release to run, e.g. 0.1.0. "latest" follows every release; pin a version
# to upgrade deliberately (docker compose pull && docker compose up -d).
HEALTHIER_VERSION=latest

# Port the app is reachable on. With docker compose this is the host port;
# the container itself always listens on 3000.
PORT=3000

# Interface the port is published on. Use 127.0.0.1 when a reverse proxy on
# this machine terminates HTTPS, so the app isn't also reachable over plain HTTP.
BIND_ADDRESS=0.0.0.0

# Public URL users open, without a trailing slash. Must match PORT when
# running on localhost, or your domain when behind a reverse proxy.
# Google redirects back to $APP_URL/auth/callback after sign-in.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Google OAuth (REQUIRED)
# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID,
# type "Web application", with $APP_URL/auth/callback as a redirect URI.
# ---------------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who may sign up. Comma-separated addresses and/or @domain entries, e.g.
#   ALLOWED_EMAILS=you@gmail.com, partner@gmail.com, @yourfamily.org
# Empty lets in anyone who can get through the Google consent screen (only
# its test users while the OAuth app is in "Testing").
ALLOWED_EMAILS=

# ---------------------------------------------------------------------------
# Secrets (REQUIRED)
# ---------------------------------------------------------------------------

# Encrypts Google tokens in the database. 32 random bytes, base64-encoded:
#   openssl rand -base64 32
# Losing or changing it means every user has to sign in again.
ENCRYPTION_KEY=

# Password for the bundled Postgres. Keep it URL-safe, e.g.:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Database
# docker compose builds this from POSTGRES_PASSWORD and ignores this value.
# Set it only when running outside compose (npm run dev) or against your
# own Postgres server.
# ---------------------------------------------------------------------------

DATABASE_URL=postgres://healthier:CHANGE_ME@localhost:5432/healthier

# ---------------------------------------------------------------------------
# Sync
# ---------------------------------------------------------------------------

# Minutes between background syncs per user. 0 turns background sync off;
# data then syncs only when someone opens the app.
SYNC_INTERVAL_MINUTES=60

# Days of daily history kept per user (62 to 3650, default 730). After the
# first sync, older history is imported in the background up to this limit.
# Minute-level heart rate is always kept for 62 days only.
HISTORY_DAYS=730
