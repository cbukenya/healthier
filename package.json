{
  "name": "healthier",
  "private": true,
  "version": "0.1.0",
  "description": "A self-hostable personal health dashboard for your Google Health data.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/cbukenya/healthier.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "TZ=UTC tsx --test src/pipeline/__tests__/pipeline.test.ts src/pipeline/__tests__/incremental.test.ts server/__tests__/server.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.6.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.55.0",
    "motion": "^12.23.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  }
}
